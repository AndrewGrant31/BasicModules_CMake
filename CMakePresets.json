{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 30,
        "patch": 0
    },
    "configurePresets": [
        {
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "description": "Default build Configuration",
            "generator": "Ninja",
            "hidden": true,
            "installDir": "${sourceDir}/out/install/${presetName}",
            "name": "default"
        },
        {
            "name": "clang_compiler",
            "displayName": "CLANG Compiler",
            "hidden": true,
            "inherits": "default",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },        
        {
            "name": "gcc_compiler",
            "displayName": "GCC Compiler",
            "hidden": true,
            "inherits": "default",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "clang-x64-debug",
            "hidden": false,
            "displayName": "CLANG X64 Debug",
            "inherits": "clang_compiler",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-x64-release",
            "hidden": false,
            "displayName": "CLANG X64 Release",
            "inherits": "clang_compiler",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "msvc_compiler",
            "displayName": "MSVC Compiler",
            "hidden": true,
            "inherits": "default",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },   
        {
            "name": "gcc-x64-debug",
            "hidden": false,
            "displayName": "GCC X64 Debug",
            "inherits": "gcc_compiler",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "gcc-x64-release",
            "hidden": false,
            "displayName": "GCC X64 Release",
            "inherits": "gcc_compiler",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "msvc-x64-debug",
            "hidden": false,
            "displayName": "MSVC X64 Debug",
            "inherits": "msvc_compiler",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "msvc-x64-release",
            "hidden": false,
            "displayName": "MSVC X64 Release",
            "inherits": "msvc_compiler",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ]
}
